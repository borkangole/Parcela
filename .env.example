# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Database. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/parcela"

# Login (Better Auth)
# Secret used to sign login sessions. Use a long random value, different on the server.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# The address where the app runs
BETTER_AUTH_URL="http://localhost:3000"
